# Copy to deploy/.env and fill in. Never commit the result, .gitignore has it.

# Where the published pack lives. During phase 0, point this at a local
# `packwiz serve` instead: http://host.docker.internal:8080/pack.toml
PACKWIZ_URL=https://weloveyou-pack.pages.dev/pack/stable/pack.toml

MC_MEMORY=6G

# Two cores, so these are the cheapest TPS lever there is. Simulation distance
# is the expensive one; view distance only streams chunks to clients.
MC_VIEW_DISTANCE=8
MC_SIMULATION_DISTANCE=6

# `java25` is a moving tag and compose pulls before every up, so pin a dated tag
# here to roll the JVM back without a rebuild.
MC_IMAGE=itzg/minecraft-server:java25

# squaremap's webserver, host side only. 8080 inside the container; 8080 on the
# host is already dozzle.
MC_MAP_PORT=8123

# Comma-separated Minecraft usernames, used only to seed whitelist.json and
# ops.json on a fresh world. Runtime additions over RCON persist and win.
MC_WHITELIST=
MC_OPS=
# Extra -XX flags on top of Aikar's. Leave empty until BENCHMARKS.md says
# otherwise; wly preflights whatever is here and drops what the JVM rejects.
MC_JVM_XX_OPTS=

RCON_PASSWORD=

# The bot token. `wly guild` reads it from the environment and nothing else does
# yet; the wly service itself still sits behind the `bot` compose profile and
# does not start by default. It is deliberately NOT given a `:?` guard in
# compose the way PACKWIZ_URL and RCON_PASSWORD are, because a required var
# would break `compose up` for anyone not running the bot, and `wly guild`
# already fails with a sentence that says where to put it.
#
# This file is the inventory of what a box needs. Never put the real value here
# - it goes in deploy/.env, which is gitignored, so `git checkout --force` on
# the box never touches it. Keep that file mode 600.
WLY_DISCORD_TOKEN=

# Postgres. Only the password is required; the rest have working defaults in
# compose. Nothing outside the compose network can reach the database, so this
# guards a service that is already unreachable, but a blank superuser password
# on anything is the kind of thing that becomes true later.
DB_PASSWORD=
#DB_NAME=wly
#DB_USER=wly

# Unused. Superseded by commit c98aefb: there is no R2 and no Worker, the pack
# is served from Cloudflare Pages and the map by squaremap's own webserver.
# Still passed through compose, and nothing consumes them.
WLY_R2_ACCESS_KEY=
WLY_R2_SECRET_KEY=

# release.yml pushes both :latest and :vX.Y.Z, multi-arch (the VPS is aarch64).
# Pin to a tag to roll back without touching the registry, this is the fastest
# lever when a release misbehaves, since it needs no rebuild and no git revert.
WLY_IMAGE=ghcr.io/6586x57890143/weloveyou.mc:latest

# Backups (deploy/backup.sh, run by wly-backup.timer on the box, NOT by compose).
# One rsync destination, deliberately temporary: the desktop over the tailnet
# today, object storage later. Empty means two local copies and nothing off-box,
# which the staleness alert will complain about eventually but is not fatal.
# Lives in /etc/default/wly-backup on the box, listed here so it is findable.
# BACKUP_TARGET=kon@100.x.y.z:/backups/wly
