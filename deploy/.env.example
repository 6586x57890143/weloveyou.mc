# Copy to deploy/.env and fill in. Never commit the result — .gitignore has it.

# Where the published pack lives. During phase 0, point this at a local
# `packwiz serve` instead: http://host.docker.internal:8080/pack.toml
PACKWIZ_URL=https://pack.example.com/stable/pack.toml

MC_MEMORY=6G
# Extra -XX flags on top of Aikar's. Leave empty until BENCHMARKS.md says
# otherwise; wly preflights whatever is here and drops what the JVM rejects.
MC_JVM_XX_OPTS=

RCON_PASSWORD=
WLY_DISCORD_TOKEN=
WLY_R2_ACCESS_KEY=
WLY_R2_SECRET_KEY=

# Pin to a tag for a real deploy; latest is fine while iterating.
WLY_IMAGE=ghcr.io/weloveyou/weloveyou.mc:latest
